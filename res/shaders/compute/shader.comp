#version 450
#extension GL_ARB_separate_shader_objects : enable

#define PI 3.14159265359
#define WORKGROUP_SIZE 8
#define CHUNK_WIDTH 16

// Path tracing settings
#define NUM_SAMPLES  100
#define MAX_BOUNCES  10
#define LIGHT_MULTIPLIER 20.0   // brightness of light source blocks

layout(local_size_x = WORKGROUP_SIZE,
       local_size_y = WORKGROUP_SIZE,
       local_size_z = 1) in;

layout(std430, binding = 0) buffer outputBuffer
{
    uint imageData[];
};

struct Vector3
{
    float x;
    float y;
    float z;
};

vec3 toVec3(Vector3 v)
{
    return vec3(v.x, v.y, v.z);
}

struct Camera
{
    Vector3 origin;
    Vector3 lowerLeftCorner;
    Vector3 horizontal;
    Vector3 vertical;
    Vector3 w;
    Vector3 u;
    Vector3 v;
    float lensRadius;
};

struct Ray
{
    vec3 origin;
    vec3 direction;
};

struct HitRecord
{
    bool hit;
    vec3 position;
    vec3 normal;
    vec3 albedo;
    vec3 emission;   // non-zero only for light sources
};

layout(std430, binding = 1) buffer inputBuffer
{
    int width;
    int height;
    int worldSize;
    uint frameSeed;
    Camera camera;
    uint blocks[];
};

// PCG hash - much better statistical properties
uint pcgHash(uint v)
{
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

// Better initialization using PCG
void initRNG(uvec2 pixel, uint sampleIndex, inout uint state)
{
    // Combine multiple inputs using PCG hash
    uint h = pcgHash(pixel.x);
    h = pcgHash(h + pixel.y);
    h = pcgHash(h + sampleIndex);
    h = pcgHash(h + frameSeed);  // frameSeed from CPU
    state = (h == 0u) ? 1u : h;
}

// LCG-based random number generation (better than xorshift for GPU)
float rand(inout uint state)
{
    state = state * 1664525u + 1013904223u;
    return float(state & 0x00FFFFFFu) / float(0x01000000u); // Use only top 24 bits for better randomness
}

// ------------------------------------------------------------------
// Camera ray
// ------------------------------------------------------------------
Ray createRay(vec3 o, vec3 d)
{
    Ray r;
    r.origin = o;
    r.direction = normalize(d);
    return r;
}

Ray getRay(float x, float y)
{
    return createRay(
        toVec3(camera.origin),
        toVec3(camera.lowerLeftCorner)
        + x * toVec3(camera.horizontal)
        + y * toVec3(camera.vertical)
        - toVec3(camera.origin));
}

void writeColor(vec3 c)
{
    imageData[width * gl_GlobalInvocationID.y + gl_GlobalInvocationID.x] =
        packUnorm4x8(vec4(c, 1.0));
}

vec3 skyColor(vec3 d)
{
    float t = 0.5 * (normalize(d).y + 1.0);
    return mix(vec3(1.0), vec3(0.5, 0.7, 1.0), t);
}

// ------------------------------------------------------------------
// World helpers
// ------------------------------------------------------------------
int worldWidth()  { return CHUNK_WIDTH * worldSize; }
int worldHeight() { return CHUNK_WIDTH * 4; }
int worldDepth()  { return CHUNK_WIDTH * worldSize; }

bool inWorld(ivec3 p)
{
    return p.x >= 0 && p.y >= 0 && p.z >= 0 &&
           p.x < worldWidth() &&
           p.y < worldHeight() &&
           p.z < worldDepth();
}

int blockIndex(ivec3 p)
{
    return p.y * worldWidth() * worldDepth() +
           p.z * worldWidth() +
           p.x;
}

uint getBlock(ivec3 p)
{
    if (!inWorld(p)) return 0u;
    return blocks[blockIndex(p)];
}

bool isSolid(uint b)
{
    return ((b >> 24) & 255u) != 0u;
}

vec3 blockColor(uint b)
{
    return vec3(
        float(b & 255u),
        float((b >> 8) & 255u),
        float((b >> 16) & 255u)
    ) / 255.0;
}

// ------------------------------------------------------------------
// Light source detection
// ------------------------------------------------------------------
bool isLightSource(vec3 albedo)
{
    float maxComp = max(max(albedo.r, albedo.g), albedo.b);
    // At least one component above 230/255
    if (maxComp <= 230.0/255.0) return false;
    // Exclude pure white (all components > 230/255)
    if (all(greaterThan(albedo, vec3(230.0/255.0)))) return false;
    return true;
}

// ------------------------------------------------------------------
// Ray-AABB intersection
// ------------------------------------------------------------------
bool intersectWorldBounds(Ray ray, out float tNear, out float tFar)
{
    vec3 worldMin = vec3(0.0);
    vec3 worldMax = vec3(float(worldWidth()), float(worldHeight()), float(worldDepth()));

    vec3 invDir = 1.0 / ray.direction;
    vec3 t0 = (worldMin - ray.origin) * invDir;
    vec3 t1 = (worldMax - ray.origin) * invDir;
    vec3 tMin = min(t0, t1);
    vec3 tMax = max(t0, t1);

    tNear = max(max(tMin.x, tMin.y), tMin.z);
    tFar  = min(min(tMax.x, tMax.y), tMax.z);

    return tNear <= tFar && tFar > 0.0;
}

// ------------------------------------------------------------------
// Voxel traversal with light source support
// ------------------------------------------------------------------
HitRecord trace(Ray ray)
{
    HitRecord hit;
    hit.hit = false;
    hit.emission = vec3(0.0);

    float tNear, tFar;
    if (!intersectWorldBounds(ray, tNear, tFar))
        return hit;

    // --- Handle ray starting outside the world ---
    if (tNear > 0.0)
    {
        vec3 entryPoint = ray.origin + ray.direction * tNear;
        const float ENTRY_EPS = 0.0001;
        vec3 insidePoint = entryPoint + ray.direction * ENTRY_EPS;

        ivec3 firstVoxel = ivec3(floor(insidePoint));
        firstVoxel = clamp(firstVoxel, ivec3(0), ivec3(worldWidth()-1, worldHeight()-1, worldDepth()-1));

        uint block = getBlock(firstVoxel);
        if (isSolid(block))
        {
            hit.hit = true;
            hit.position = entryPoint;
            hit.albedo = blockColor(block);
            if (isLightSource(hit.albedo))
                hit.emission = hit.albedo * LIGHT_MULTIPLIER;

            // Normal from dominant entry direction
            vec3 absDir = abs(ray.direction);
            if (absDir.x >= absDir.y && absDir.x >= absDir.z)
                hit.normal = vec3(-sign(ray.direction.x), 0.0, 0.0);
            else if (absDir.y >= absDir.z)
                hit.normal = vec3(0.0, -sign(ray.direction.y), 0.0);
            else
                hit.normal = vec3(0.0, 0.0, -sign(ray.direction.z));
            return hit;
        }

        ray.origin = entryPoint;
    }

    // Starting voxel inside the world
    ivec3 voxel;
    if (tNear > 0.0)
        voxel = ivec3(floor(ray.origin + ray.direction * 0.0001));
    else
        voxel = ivec3(floor(ray.origin));

    voxel = clamp(voxel, ivec3(0), ivec3(worldWidth()-1, worldHeight()-1, worldDepth()-1));

    ivec3 step = ivec3(sign(ray.direction));
    vec3 invDir = 1.0 / ray.direction;
    vec3 delta = abs(invDir);

    vec3 side;
    side.x = (ray.direction.x > 0.0)
        ? (float(voxel.x + 1) - ray.origin.x) * delta.x
        : (ray.origin.x - float(voxel.x)) * delta.x;
    side.y = (ray.direction.y > 0.0)
        ? (float(voxel.y + 1) - ray.origin.y) * delta.y
        : (ray.origin.y - float(voxel.y)) * delta.y;
    side.z = (ray.direction.z > 0.0)
        ? (float(voxel.z + 1) - ray.origin.z) * delta.z
        : (ray.origin.z - float(voxel.z)) * delta.z;

    while (inWorld(voxel))
    {
        int   axis = 0;
        float minSide = side.x;
        const float EPS_COMP = 1e-6;
        if (side.y < minSide - EPS_COMP) { minSide = side.y; axis = 1; }
        if (side.z < minSide - EPS_COMP) { minSide = side.z; axis = 2; }

        ivec3 nextVoxel = voxel;
        if (axis == 0)      nextVoxel.x += step.x;
        else if (axis == 1) nextVoxel.y += step.y;
        else                nextVoxel.z += step.z;

        if (inWorld(nextVoxel))
        {
            uint block = getBlock(nextVoxel);
            if (isSolid(block))
            {
                hit.hit = true;
                hit.position = ray.origin + ray.direction * minSide;
                hit.albedo = blockColor(block);
                if (isLightSource(hit.albedo))
                    hit.emission = hit.albedo * LIGHT_MULTIPLIER;

                if      (axis == 0) hit.normal = vec3(float(-step.x), 0.0, 0.0);
                else if (axis == 1) hit.normal = vec3(0.0, float(-step.y), 0.0);
                else                hit.normal = vec3(0.0, 0.0, float(-step.z));

                return hit;
            }
        }

        voxel = nextVoxel;
        if (axis == 0)      side.x += delta.x;
        else if (axis == 1) side.y += delta.y;
        else                side.z += delta.z;
    }

    return hit;
}

// ------------------------------------------------------------------
// Cosine‑weighted hemisphere sampling
// ------------------------------------------------------------------
void sampleHemisphereCosine(vec3 normal, inout uint rngState,
                            out vec3 wi, out float pdf)
{
    float r1 = rand(rngState);
    float r2 = rand(rngState);

    float phi      = 2.0 * PI * r1;
    float cosTheta = sqrt(1.0 - r2);
    float sinTheta = sqrt(r2);

    vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 u = normalize(cross(up, normal));
    vec3 v = cross(normal, u);

    wi = u * (sinTheta * cos(phi)) +
         v * (sinTheta * sin(phi)) +
         normal * cosTheta;

    pdf = cosTheta / PI;
}

// ------------------------------------------------------------------
// Path tracing kernel
// ------------------------------------------------------------------
void main()
{
    if (gl_GlobalInvocationID.x >= uint(width) ||
        gl_GlobalInvocationID.y >= uint(height))
        return;

    uvec2 pixel = gl_GlobalInvocationID.xy;
    vec3 accumulated = vec3(0.0);

    for (uint s = 0; s < NUM_SAMPLES; ++s)
    {
        uint rngState;
        initRNG(pixel, s, rngState);

        float u = (float(pixel.x) + rand(rngState)) / float(width - 1);
        float v = (float(pixel.y) + rand(rngState)) / float(height - 1);

        Ray ray = getRay(u, v);
        vec3 throughput = vec3(1.0);
        vec3 radiance   = vec3(0.0);

        for (int bounce = 0; bounce < MAX_BOUNCES; ++bounce)
        {
            HitRecord hit = trace(ray);

            if (!hit.hit)
            {
                radiance += throughput * skyColor(ray.direction);
                break;
            }

            // If we hit a light source, add its emission and stop
            if (length(hit.emission) > 0.0)
            {
                radiance += throughput * hit.emission;
                break;
            }

            // Russian roulette
            if (bounce > 2)
            {
                float p = max(max(throughput.x, throughput.y), throughput.z);
                if (rand(rngState) > p)
                    break;
                throughput /= p;
            }

            // Sample new direction (Lambertian)
            vec3 wi;
            float pdf;
            sampleHemisphereCosine(hit.normal, rngState, wi, pdf);

            throughput *= hit.albedo;

            // Robust bounce origin
            const float NUDGE_NORMAL = 0.001;
            const float NUDGE_RAY    = 0.0001;
            ray.origin = hit.position + hit.normal * NUDGE_NORMAL + wi * NUDGE_RAY;
            ray.direction = wi;

            // Safety nudge
            for (int safety = 0; safety < 10; safety++)
            {
                ivec3 testVoxel = ivec3(floor(ray.origin));
                if (!inWorld(testVoxel)) break;
                uint b = getBlock(testVoxel);
                if (!isSolid(b)) break;
                ray.origin += ray.direction * 0.001;
            }
        }

        accumulated += radiance;
    }

    vec3 finalColor = accumulated / float(NUM_SAMPLES);
    writeColor(finalColor);
}
